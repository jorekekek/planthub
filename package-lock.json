{
  "name": "planthub",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "planthub",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "server"
      ]
    },
    "apps/mobile": {
      "name": "@planthub/mobile",
      "version": "1.0.0",
      "license": "ISC"
    },
    "apps/web": {
      "name": "@planthub/web",
      "version": "1.0.0",
      "license": "ISC"
    },
    "node_modules/@planthub/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@planthub/server": {
      "resolved": "server",
      "link": true
    },
    "node_modules/@planthub/web": {
      "resolved": "apps/web",
      "link": true
    },
    "server": {
      "name": "@planthub/server",
      "version": "1.0.0",
      "license": "ISC"
    }
  }
}
